    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./constants": {
      "types": "./types/constants.d.ts",
      "default": "./src/constants.js"
    }
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  }
}
